# Mistral Vibe in a container, talking to the vllm-mlx server on the host.
# Built as linux/amd64: the podman applehv VM on this machine only execs amd64
# binaries (arm64 images fail with "Exec format error").
FROM --platform=linux/amd64 python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir mistral-vibe \
    && python -m venv /opt/garmin-venv \
    && /opt/garmin-venv/bin/pip install --no-cache-dir "git+https://github.com/Taxuspt/garmin_mcp"

WORKDIR /work
ENTRYPOINT ["vibe"]
