<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.vllm-mlx</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/nambrosini/.local/venvs/llm-server/bin/vllm-mlx</string>
        <string>serve</string>
        <string>--models-config</string>
        <string>/Users/nambrosini/.config/vllm-mlx/models.yaml</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8080</string>
        <string>--max-request-tokens</string>
        <string>32768</string>
        <string>--enable-prefix-cache</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/nambrosini/.local/var/log/vllm-mlx.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nambrosini/.local/var/log/vllm-mlx.err.log</string>
</dict>
</plist>
